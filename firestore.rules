rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function mitglied(code) {
      return /databases/$(database)/documents/familien/$(code)/mitglieder/$(request.auth.uid);
    }
    function istMitglied(code) {
      return request.auth != null && exists(mitglied(code));
    }
    function darfSchreiben(code) {
      return istMitglied(code) && get(mitglied(code)).data.get('rolle', 'schreiben') != 'lesen';
    }
    function istAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function gesperrt(code) {
      return exists(/databases/$(database)/documents/gesperrt/$(code));
    }

    // Termin-Schutz: geschützte Einträge darf nur der Ersteller löschen oder entsperren
    function vomErsteller() {
      return !resource.data.get('geschuetzt', false) || resource.data.get('ersteller', '') == request.auth.uid;
    }
    function erstellerBleibt() {
      return request.resource.data.get('ersteller', '') == resource.data.get('ersteller', '')
        || (resource.data.get('ersteller', '') == '' && request.resource.data.get('ersteller', '') == request.auth.uid);
    }
    function schutzNurEigen() {
      return !request.resource.data.get('geschuetzt', false) || request.resource.data.get('ersteller', '') == request.auth.uid;
    }

    match /familien/{code}/eintraege/{eintrag} {
      allow read: if code.size() >= 18 && !gesperrt(code);
      allow create: if code.size() >= 18 && darfSchreiben(code) && !gesperrt(code) && schutzNurEigen();
      allow update: if code.size() >= 18 && darfSchreiben(code) && !gesperrt(code) && (
        (vomErsteller() && erstellerBleibt() && schutzNurEigen())
        || (resource.data.get('geschuetzt', false) == true
            && request.resource.data.get('geschuetzt', false) == true
            && request.resource.data.get('ersteller', '') == resource.data.get('ersteller', '')));
      allow delete: if code.size() >= 18 && darfSchreiben(code) && !gesperrt(code) && vomErsteller();
      allow read, delete: if istAdmin();
    }

    match /familien/{code}/mitglieder/{uid} {
      allow read: if istMitglied(code);
      allow create: if code.size() >= 18 && request.auth != null && request.auth.uid == uid && (
        request.resource.data.rolle == 'lesen'
        || (request.resource.data.rolle == 'schreiben' && (
              !exists(/databases/$(database)/documents/familien/$(code)/eintraege/_config)
              || (request.resource.data.get('token', '').size() >= 18
                  && exists(/databases/$(database)/documents/familien/$(code)/einladungen/$(request.resource.data.get('token', '')))))));
      allow update: if (request.auth != null && request.auth.uid == uid
          && request.resource.data.get('rolle', 'schreiben') == resource.data.get('rolle', 'schreiben'))
        || darfSchreiben(code);
      allow delete: if darfSchreiben(code);
    }

    match /familien/{code}/einladungen/{tok} {
      allow read, delete: if darfSchreiben(code);
      allow create: if tok.size() >= 18 && darfSchreiben(code);
    }

    // Support: jeder darf schicken, Absender kann seine eigene Nachricht (über die geheime ID) abrufen
    match /support/{id} {
      allow create: if request.resource.data.keys().hasOnly(['art', 'text', 'name', 'kontakt', 'info', 'zeit', 'status'])
        && request.resource.data.art in ['frage', 'fehler', 'idee']
        && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 1000
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.kontakt is string && request.resource.data.kontakt.size() <= 100
        && request.resource.data.info is string && request.resource.data.info.size() <= 300
        && request.resource.data.zeit is string && request.resource.data.zeit.size() <= 40
        && request.resource.data.status == 'neu';
      allow get: if id.size() >= 20 || istAdmin();
      allow list, update, delete: if istAdmin();
    }

    // Automatische Fehlerberichte
    match /fehler/{id} {
      allow create: if request.resource.data.keys().hasOnly(['msg', 'ort', 'info', 'zeit'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.ort is string && request.resource.data.ort.size() <= 200
        && request.resource.data.info is string && request.resource.data.info.size() <= 300
        && request.resource.data.zeit is string && request.resource.data.zeit.size() <= 40;
      allow read, delete: if istAdmin();
    }

    // Mitteilungen, Umfrage, Steuerung: jeder liest, nur der Betreiber schreibt
    match /info/{doc} {
      allow read: if true;
      allow write: if istAdmin();
    }
    match /famhinweis/{nr} {
      allow read: if true;
      allow write: if istAdmin();
    }
    match /gesperrt/{code} {
      allow read: if true;
      allow write: if istAdmin();
    }

    match /umfragen/{pid}/stimmen/{uid} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['wahl', 'zeit'])
        && request.resource.data.wahl is int && request.resource.data.wahl >= 0 && request.resource.data.wahl < 10;
      allow read, delete: if istAdmin();
    }

    match /ideen/{id} {
      allow read: if resource.data.status in ['offen', 'geplant', 'umgesetzt'] || istAdmin();
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['text', 'zeit', 'stimmen', 'status'])
        && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 200
        && request.resource.data.zeit is string && request.resource.data.zeit.size() <= 40
        && request.resource.data.stimmen == 0 && request.resource.data.status == 'neu';
      allow update: if istAdmin() || (request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stimmen'])
        && request.resource.data.stimmen == resource.data.stimmen + 1
        && !exists(/databases/$(database)/documents/ideen/$(id)/votes/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/ideen/$(id)/votes/$(request.auth.uid)));
      allow delete: if istAdmin();

      match /votes/{uid} {
        allow create: if request.auth != null && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['zeit']);
        allow read, delete: if istAdmin();
      }
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /leselinks/{rc} {
      allow read, update: if false;
      allow create: if rc.size() >= 18 && darfSchreiben(request.resource.data.fam);
      allow delete: if darfSchreiben(resource.data.fam);
    }

    match /lesen/{rc} {
      allow read: if rc.size() >= 18;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/leselinks/$(rc))
        && darfSchreiben(get(/databases/$(database)/documents/leselinks/$(rc)).data.fam);

      match /wuensche/{w} {
        allow read: if rc.size() >= 18;
        allow create: if rc.size() >= 18
          && exists(/databases/$(database)/documents/lesen/$(rc))
          && request.resource.data.status == "offen"
          && request.resource.data.size() <= 8
          && request.resource.data.text is string && request.resource.data.text.size() <= 300
          && request.resource.data.von is string && request.resource.data.von.size() == 10;
        allow delete: if rc.size() >= 18;
        allow update: if request.auth != null
          && exists(/databases/$(database)/documents/leselinks/$(rc))
          && darfSchreiben(get(/databases/$(database)/documents/leselinks/$(rc)).data.fam);
      }
    }
  }
}
