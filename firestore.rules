rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /familien/{code}/eintraege/{eintrag} {
      allow read, write: if code.size() >= 18;
    }

    match /familien/{code}/mitglieder/{uid} {
      allow create, update: if code.size() >= 18 && request.auth != null && request.auth.uid == uid;
      allow read, delete: if false;
    }

    match /leselinks/{rc} {
      allow read, update: if false;
      allow create: if rc.size() >= 18 && request.auth != null
        && exists(/databases/$(database)/documents/familien/$(request.resource.data.fam)/mitglieder/$(request.auth.uid));
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/familien/$(resource.data.fam)/mitglieder/$(request.auth.uid));
    }

    match /lesen/{rc} {
      allow read: if rc.size() >= 18;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/leselinks/$(rc))
        && exists(/databases/$(database)/documents/familien/$(get(/databases/$(database)/documents/leselinks/$(rc)).data.fam)/mitglieder/$(request.auth.uid));

      // Wünsche über den Nur-Lese-Link (z. B. von Papa)
      match /wuensche/{w} {
        allow read: if rc.size() >= 18;
        allow create: if rc.size() >= 18
          && exists(/databases/$(database)/documents/lesen/$(rc))
          && request.resource.data.status == "offen"
          && request.resource.data.size() <= 8
          && request.resource.data.text is string && request.resource.data.text.size() <= 300
          && request.resource.data.von is string && request.resource.data.von.size() == 10;
        allow delete: if rc.size() >= 18;
        allow update: if request.auth != null
          && exists(/databases/$(database)/documents/leselinks/$(rc))
          && exists(/databases/$(database)/documents/familien/$(get(/databases/$(database)/documents/leselinks/$(rc)).data.fam)/mitglieder/$(request.auth.uid));
      }
    }
  }
}
