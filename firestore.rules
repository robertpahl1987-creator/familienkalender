rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function mitglied(code) {
      return /databases/$(database)/documents/familien/$(code)/mitglieder/$(request.auth.uid);
    }
    function istMitglied(code) {
      return request.auth != null && exists(mitglied(code));
    }
    function darfSchreiben(code) {
      return istMitglied(code) && get(mitglied(code)).data.get('rolle', 'schreiben') != 'lesen';
    }

    match /familien/{code}/eintraege/{eintrag} {
      allow read: if code.size() >= 18;
      allow write: if code.size() >= 18 && darfSchreiben(code);
    }

    match /familien/{code}/mitglieder/{uid} {
      allow read: if istMitglied(code);
      allow create: if code.size() >= 18 && request.auth != null && request.auth.uid == uid && (
        request.resource.data.rolle == 'lesen'
        || (request.resource.data.rolle == 'schreiben' && (
              !exists(/databases/$(database)/documents/familien/$(code)/eintraege/_config)
              || (request.resource.data.get('token', '').size() >= 18
                  && exists(/databases/$(database)/documents/familien/$(code)/einladungen/$(request.resource.data.get('token', '')))))));
      allow update: if (request.auth != null && request.auth.uid == uid
          && request.resource.data.get('rolle', 'schreiben') == resource.data.get('rolle', 'schreiben'))
        || darfSchreiben(code);
      allow delete: if darfSchreiben(code);
    }

    match /familien/{code}/einladungen/{tok} {
      allow read, delete: if darfSchreiben(code);
      allow create: if tok.size() >= 18 && darfSchreiben(code);
    }

    // Support-Nachrichten: jeder darf schicken, nur der Betreiber (admins/{uid}) lesen
    match /support/{id} {
      allow create: if request.resource.data.keys().hasOnly(['art', 'text', 'name', 'kontakt', 'info', 'zeit', 'status'])
        && request.resource.data.art in ['frage', 'fehler', 'idee']
        && request.resource.data.text is string && request.resource.data.text.size() >= 3 && request.resource.data.text.size() <= 1000
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.kontakt is string && request.resource.data.kontakt.size() <= 100
        && request.resource.data.info is string && request.resource.data.info.size() <= 300
        && request.resource.data.zeit is string && request.resource.data.zeit.size() <= 40
        && request.resource.data.status == 'neu';
      allow read, update, delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Mitteilung an alle: jeder darf lesen, nur der Betreiber schreiben
    match /info/{doc} {
      allow read: if true;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /leselinks/{rc} {
      allow read, update: if false;
      allow create: if rc.size() >= 18 && darfSchreiben(request.resource.data.fam);
      allow delete: if darfSchreiben(resource.data.fam);
    }

    match /lesen/{rc} {
      allow read: if rc.size() >= 18;
      allow write: if request.auth != null
        && exists(/databases/$(database)/documents/leselinks/$(rc))
        && darfSchreiben(get(/databases/$(database)/documents/leselinks/$(rc)).data.fam);

      // Wünsche über den Nur-Lese-Link (z. B. von Papa)
      match /wuensche/{w} {
        allow read: if rc.size() >= 18;
        allow create: if rc.size() >= 18
          && exists(/databases/$(database)/documents/lesen/$(rc))
          && request.resource.data.status == "offen"
          && request.resource.data.size() <= 8
          && request.resource.data.text is string && request.resource.data.text.size() <= 300
          && request.resource.data.von is string && request.resource.data.von.size() == 10;
        allow delete: if rc.size() >= 18;
        allow update: if request.auth != null
          && exists(/databases/$(database)/documents/leselinks/$(rc))
          && darfSchreiben(get(/databases/$(database)/documents/leselinks/$(rc)).data.fam);
      }
    }
  }
}
